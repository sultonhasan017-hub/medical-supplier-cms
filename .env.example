# Environment variables declared in this file are automatically made available to Prisma.
# Salin file ini ke .env dan isi nilainya.

# Koneksi Database PostgreSQL (Neon, Supabase, atau lokal)
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Rahasia JWT untuk otentikasi Admin
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="ganti-dengan-rahasia-panjang-dan-acak-minimal-64-karakter"

# WhatsApp — nomor tujuan chat dengan kode negara (tanpa + atau 0 di depan)
# Contoh Indonesia: 6289630555037
NEXT_PUBLIC_WA_PHONE_NUMBER="628XXXXXXXXXX"
